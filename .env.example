# Скопировать в .env и заполнить. .env не коммитится.

POSTGRES_PASSWORD=change-me

# ОБЯЗАТЕЛЬНО заменить перед любым развёртыванием: этим значением подписывается
# сессионная кука. Известный секрет = любой желающий подписывает себе куку
# администратора. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# С дефолтным/коротким значением приложение при ENVIRONMENT=production не
# стартует, а в development пишет предупреждение в лог.
SESSION_SECRET=

# development (по умолчанию) — куки без Secure, слабый SESSION_SECRET допустим.
# production — Secure-кука и жёсткая проверка SESSION_SECRET при старте.
ENVIRONMENT=development

# Кто может завести аккаунт:
#   invite — только по одноразовому коду из /admin/invites (по умолчанию)
#   open   — любой желающий (публичный реселлинг)
#   closed — регистрация выключена совсем
SIGNUP_MODE=invite

# ─────────────────────────────────────────────────────────────────────────
# ДВА ЭКЗЕМПЛЯРА НА ОДНОМ КОДЕ
#
# Внутренний кабинет для своих разработчиков и клиентский сервис поднимаются
# одним и тем же кодом, но раздельно: своя база, свой домен, свои настройки.
# Наценка, курс, цены моделей и пользователи живут в БАЗЕ, поэтому
# разделяются сами собой — различать нужно только то, что ниже.
#
# Внутренний:   SIGNUP_MODE=invite, INSTANCE_NAME=внутренний
#               ENABLE_SHOP=false ENABLE_PROMPTS=false
#               ENABLE_CHILDREN=false ENABLE_ARCHIVE=false
#               APP_PORT=8020  DB_PORT=5434
#
# Клиентский:   SIGNUP_MODE=open,   INSTANCE_NAME=клиентский
#               APP_PORT=8030  DB_PORT=5435
#
# Запуск двух копий на одном хосте — из разных каталогов (docker compose
# берёт имя проекта из имени каталога, тома получаются разные), либо одной
# командой с явным именем проекта:
#   docker compose -p flawless-internal --env-file .env.internal up -d
#   docker compose -p flawless-public   --env-file .env.public   up -d
#
# ВАЖНО для второго способа: каждый файл настроек обязан назвать сам себя
# строкой ENV_FILE=<своё имя> (например ENV_FILE=.env.internal). Флаг
# --env-file подставляет переменные только в сам compose-файл, а внутрь
# контейнера уходит именно тот файл, что указан в ENV_FILE. Без этой строки
# второй экземпляр молча поднимется с настройками первого — проверено.
#
# ВАЖНО: TELEGRAM_BOT_TOKEN у экземпляров должен быть РАЗНЫЙ (или пустой у
# одного). Два процесса с одним токеном воруют друг у друга сообщения.
# ─────────────────────────────────────────────────────────────────────────

# Подпись в шапке кабинета, чтобы не перепутать две одинаковые админки.
INSTANCE_NAME=

# Необязательные разделы. Выключенный раздел исчезает из меню И отдаёт 404 —
# адрес не работает в обход интерфейса.
ENABLE_SHOP=true
ENABLE_PROMPTS=true
ENABLE_CHILDREN=true
ENABLE_ARCHIVE=true

# Порты на хосте (нужны разные, если экземпляров два).
APP_PORT=8020
DB_PORT=5434

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# AI-секретарь: токен бота от @BotFather. Пусто = функция выключена.
TELEGRAM_BOT_TOKEN=
