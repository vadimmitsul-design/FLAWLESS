# ВНУТРЕННИЙ КАБИНЕТ — закупка нейронок для своих разработчиков.
# Скопировать в .env.internal, заполнить, поднять:
#   docker compose -p flawless-internal --env-file .env.internal up -d
# .env.internal в git не попадает (см. .gitignore).

# Обязана называть сама себя: --env-file подставляет переменные только в
# compose-файл, а ВНУТРЬ контейнера уходит именно этот файл. Без строки
# экземпляр молча поднимется с настройками соседа.
ENV_FILE=.env.internal

POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ENVIRONMENT=production

# Свои заводятся по одноразовому коду из /admin/invites — улицы здесь нет.
SIGNUP_MODE=invite
INSTANCE_NAME=внутренний

# Адрес, который показывается клиенту в документации и на лендинге как
# base_url для OpenAI SDK (примеры curl, SDK, Cursor, OpenWebUI). Пусто —
# берётся умолчание из кода (https://api.flawless.ru), и вся документация
# зовёт на домен, которого может не быть. Без /v1 на конце: его дописывают
# сами клиенты. Локально: http://localhost:8020
PUBLIC_BASE_URL=


# Магазин подписок, платные промпты, детские аккаунты и архив диалогов —
# это витрина для внешних клиентов. Внутри они не нужны и выключены:
# раздел исчезает из меню И отдаёт 404, в обход интерфейса не открыть.
# Публичная витрина (лендинг, цены, решения) внутри не нужна:
# «/» сразу ведёт на вход, адреса витрины отдают 404.
ENABLE_PUBLIC_SITE=false
# Прокси и подписки со сроками — ровно то, ради чего внутренний кабинет.
ENABLE_RESOURCES=true
ENABLE_SHOP=false
ENABLE_PROMPTS=false
ENABLE_CHILDREN=false
ENABLE_ARCHIVE=false

APP_PORT=8020
DB_PORT=5434

# Закупка идёт через OpenRouter: один ключ на все модели.
OPENROUTER_API_KEY=

# Прямые ключи провайдеров — опционально.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Токен ОБЯЗАН отличаться от клиентского экземпляра (или быть пустым).
# Два процесса с одним токеном воруют друг у друга сообщения.
TELEGRAM_BOT_TOKEN=
