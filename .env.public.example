# КЛИЕНТСКИЙ СЕРВИС — внешние заказчики.
# Скопировать в .env.public, заполнить, поднять:
#   docker compose -p flawless-public --env-file .env.public up -d
# .env.public в git не попадает (см. .gitignore).

ENV_FILE=.env.public

POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ENVIRONMENT=production

# open — самостоятельная регистрация. Включать только когда есть оферта,
# политика обработки данных и приём платежей; до этого держать invite.
SIGNUP_MODE=open
INSTANCE_NAME=клиентский

# Адрес, который показывается клиенту в документации и на лендинге как
# base_url для OpenAI SDK (примеры curl, SDK, Cursor, OpenWebUI). Пусто —
# берётся умолчание из кода (https://api.flawless.ru), и вся документация
# зовёт на домен, которого может не быть. Без /v1 на конце: его дописывают
# сами клиенты. Локально: http://localhost:8020
PUBLIC_BASE_URL=


# Клиентский контур — витрина нужна.
ENABLE_PUBLIC_SITE=true
# Клиентам чужие прокси ни к чему.
ENABLE_RESOURCES=false
ENABLE_SHOP=true
ENABLE_PROMPTS=true
ENABLE_CHILDREN=true
ENABLE_ARCHIVE=true

# Другие порты и другая база — экземпляры не пересекаются ничем.
APP_PORT=8030
DB_PORT=5435

# Закупка идёт через OpenRouter: один ключ на все модели.
OPENROUTER_API_KEY=

# Прямые ключи провайдеров — опционально.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Отдельный бот от @BotFather, не тот же, что у внутреннего.
TELEGRAM_BOT_TOKEN=
